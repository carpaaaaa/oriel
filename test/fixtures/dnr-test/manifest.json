{
  "name": "DNR test",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Rules for test/extensions_dnr.py",
  "background": { "service_worker": "sw.js" },
  "action": { "default_popup": "popup.html", "default_title": "DNR test" },
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "say-hi": { "suggested_key": { "default": "Ctrl+Shift+Y" }, "description": "Say hi" },
    "_execute_action": { "suggested_key": { "windows": "Alt+Shift+K", "default": "Alt+Shift+J" } },
    "taken": { "suggested_key": { "default": "Ctrl+T" }, "description": "Wants a key the browser keeps" },
    "no-key": { "description": "No key at all" }
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "base", "enabled": true, "path": "rules/base.json" },
      { "id": "extra", "enabled": false, "path": "rules/extra.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["noop.js", "blocked.html"], "matches": ["<all_urls>"], "use_dynamic_url": true }
  ]
}
